# ============================================================
# RAG Agent Platform - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# All secrets MUST be read from environment variables.
# NEVER hardcode API keys in source code.
# ============================================================

# ── LLM (OpenAI-compatible API, supports Qwen via DashScope) ──
LLM_PROVIDER=openai
LLM_MODEL=qwen3.8-flash
LLM_BASE_URL=https://ws-yd9ijsp7q2ieflqf.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
DASHSCOPE_API_KEY=your_dashscope_api_key_here
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# ── Embedding (BGE-M3, free, local) ──
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=./data/model_cache

# ── Reranker (BGE-reranker-v2-m3, free, local) ──
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_TOP_N=5

# ── Milvus (Vector Database) ──
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION_PREFIX=rag_kb_

# ── Elasticsearch (BM25) ──
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_PREFIX=rag-kb-

# ── PostgreSQL ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rag_platform
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── App ──
DEBUG=false
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── File Upload ──
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md,.csv,.xlsx

# ── Chunking ──
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Retrieval ──
RETRIEVAL_TOP_K=10
RRF_K=60
HYBRID_WEIGHT_VECTOR=0.7
HYBRID_WEIGHT_BM25=0.3

# ── Agent ──
AGENT_MAX_ITERATIONS=5
AGENT_TIMEOUT_SECONDS=120

# ── Memory ──
MEMORY_MAX_TURNS=20
MEMORY_SUMMARY_THRESHOLD=15

# ── Logging ──
LOG_LEVEL=INFO
LOG_DIR=./data/logs
